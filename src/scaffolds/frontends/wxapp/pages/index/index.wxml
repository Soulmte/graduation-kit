<view class="container">
  <view class="card" wx:if="{{userInfo}}">
    <view class="flex">
      <image src="{{avatarUrl}}" class="avatar avatar--sm" mode="aspectFill" />
      <view>
        <view class="cell-title">{{userInfo.nickname || userInfo.username}}</view>
        <view class="text-muted">{{userInfo.role === 'admin' ? '管理员' : '普通用户'}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{!userInfo}}">
    <view class="empty">
      <view class="mb-md">未登录</view>
      <navigator url="/pages/login/login" class="link">点击登录</navigator>
    </view>
  </view>

  <view class="card">
    <view class="section-title">公告列表</view>
    <block wx:if="{{list.length > 0}}">
      <view class="cell-item" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="cell-title">{{item.title}}</view>
        <view class="cell-desc">{{item.content}}</view>
        <view class="cell-meta">{{item.createTime}}</view>
      </view>
    </block>
    <view wx:else class="empty">暂无公告</view>
  </view>

  <view class="flex gap-md mt-md" wx:if="{{userInfo}}">
    <navigator url="/pages/profile/profile" class="card card--action">
      <view class="text-secondary">个人信息</view>
    </navigator>
    <view class="card card--action" bindtap="handleLogout">
      <view class="text-danger">退出登录</view>
    </view>
  </view>
</view>
