<view class="page">
  <view class="index-hero">
    <view class="hero-card" wx:if="{{userInfo}}">
      <view class="avatar-frame">
        <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      </view>
      <view class="profile-info">
        <view class="hero-name">{{userInfo.nickname || userInfo.username}}</view>
        <view class="hero-sub">{{userInfo.role === 'admin' ? '管理员' : '普通用户'}}</view>
      </view>
    </view>

    <view class="hero-card" wx:else bindtap="goLogin">
      <view class="avatar-frame">
        <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      </view>
      <view class="profile-info">
        <view class="hero-name">未登录</view>
        <view class="hero-sub">点击登录后查看公告</view>
      </view>
      <t-icon name="chevron-right" size="40rpx" color="#ffffff" />
    </view>
  </view>

  <view class="block">
    <t-cell-group theme="default" title="最新公告">
      <t-cell
        wx:for="{{list}}"
        wx:key="id"
        title="{{item.title}}"
        description="{{item.createTime}}"
        arrow
        data-id="{{item.id}}"
        bind:click="goDetail"
      />
      <t-cell wx:if="{{list.length}}" title="查看全部公告" arrow bind:click="goNoticeList" />
    </t-cell-group>
  </view>

  <view class="empty-wrap">
    <t-empty wx:if="{{!list.length}}" icon="info-circle" description="暂无公告" />
  </view>

  <tab-bar active="home" />
</view>
