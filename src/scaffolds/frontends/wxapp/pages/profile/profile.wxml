<view class="page">
  <view class="block profile-head" bindtap="goEdit">
    <view class="avatar-frame">
      <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
    </view>
    <view class="profile-info">
      <view class="profile-name">{{name}}</view>
      <view class="profile-sub">{{roleText}}{{userInfo.username ? ' · ' + userInfo.username : ''}}</view>
    </view>
    <t-icon name="chevron-right" size="36rpx" color="#c0c0c0" />
  </view>

  <view class="block">
    <t-cell-group theme="default">
      <t-cell title="个人资料" description="头像、昵称、手机号、邮箱" arrow bind:click="goEdit" />
      <t-cell title="修改密码" description="改完需要用新密码重新登录" arrow bind:click="goPassword" />
      <t-cell title="用户协议" description="使用条款与免责说明" arrow data-type="user" bind:click="goAgreement" />
      <t-cell title="隐私政策" description="我们收集哪些信息、怎么用" arrow data-type="privacy" bind:click="goAgreement" />
      <t-cell title="关于应用" description="版本、技术栈与接口地址" arrow bind:click="goAbout" />
    </t-cell-group>
  </view>

  <view class="actions">
    <view class="app-btn app-btn--danger" hover-class="app-btn--hover" bindtap="handleLogout">
      退出登录
    </view>
  </view>

  <tab-bar active="profile" />
</view>
