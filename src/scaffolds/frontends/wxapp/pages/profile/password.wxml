<view class="page">
  <view class="block">
    <t-cell-group theme="default">
      <t-input label="原密码" type="password" placeholder="请输入原密码" value="{{oldPassword}}" data-field="oldPassword" bind:change="onInput" borderless />
      <t-input label="新密码" type="password" placeholder="6-20 位新密码" value="{{newPassword}}" data-field="newPassword" bind:change="onInput" borderless />
      <t-input label="确认新密码" type="password" placeholder="请再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" bind:change="onInput" borderless />
    </t-cell-group>
  </view>

  <view class="actions">
    <view
      class="app-btn app-btn--primary {{loading ? 'app-btn--disabled' : ''}}"
      hover-class="app-btn--hover"
      bindtap="handleSubmit"
    >
      {{loading ? '提交中…' : '确认修改'}}
    </view>
    <view class="pwd-tip">修改成功后会退出登录，请用新密码重新登录。</view>
  </view>
</view>
