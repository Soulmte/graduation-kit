<view class="page">
  <view class="login-hero">
    <view class="login-logo">S</view>
    <view class="page-title text-center">欢迎登录</view>
    <view class="page-subtitle text-center">多技术栈脚手架 · 微信小程序</view>
  </view>

  <t-tabs value="{{mode}}" theme="line" space-evenly bind:change="onModeChange">
    <t-tab-panel label="微信登录" value="wx">
      <view class="login-panel">
        <view
          class="app-btn app-btn--primary {{wxLoading ? 'app-btn--disabled' : ''}}"
          hover-class="app-btn--hover"
          bindtap="handleWxLogin"
        >
          {{wxLoading ? '登录中…' : '微信一键登录'}}
        </view>
        <view class="login-tip">首次登录会自动创建账号，无需注册。</view>
      </view>
    </t-tab-panel>

    <t-tab-panel label="账号密码" value="pwd">
      <view class="block">
        <t-cell-group theme="default">
          <t-input
            label="用户名"
            placeholder="请输入用户名"
            value="{{username}}"
            clearable
            borderless
            data-field="username"
            bind:change="onInput"
          />
          <t-input
            label="密码"
            type="password"
            placeholder="请输入密码"
            value="{{password}}"
            borderless
            data-field="password"
            bind:change="onInput"
          />
        </t-cell-group>
      </view>

      <view class="login-panel">
        <view
          class="app-btn app-btn--primary {{loading ? 'app-btn--disabled' : ''}}"
          hover-class="app-btn--hover"
          bindtap="handleLogin"
        >
          {{loading ? '登录中…' : '登录'}}
        </view>
      </view>
    </t-tab-panel>
  </t-tabs>

  <view class="foot-link">
    <text>还没有账号？</text>
    <text class="link" bindtap="goRegister">立即注册</text>
  </view>
</view>
