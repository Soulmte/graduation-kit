<view class="container">
  <view class="card mt-xl">
    <view class="page-title text-center">欢迎登录</view>
    <view class="page-subtitle text-center">多技术栈脚手架</view>

    <view class="input-group">
      <label>用户名</label>
      <input placeholder="请输入用户名" bindinput="onInput" data-field="username" />
    </view>
    <view class="input-group">
      <label>密码</label>
      <input placeholder="请输入密码" password bindinput="onInput" data-field="password" />
    </view>

    <button class="btn-primary mt-lg" loading="{{loading}}" bindtap="handleLogin">登录</button>

    <view class="text-center mt-md text-muted">
      还没有账号？<navigator url="/pages/register/register" class="link">立即注册</navigator>
    </view>
  </view>
</view>
