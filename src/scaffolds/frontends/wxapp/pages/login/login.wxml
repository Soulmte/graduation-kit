<view class="container">
  <view class="card" style="margin-top: 80rpx;">
    <view class="page-title" style="text-align:center">欢迎登录</view>
    <view class="page-subtitle" style="text-align:center">多技术栈脚手架</view>

    <view class="input-group">
      <label>用户名</label>
      <input placeholder="请输入用户名" bindinput="onInput" data-field="username" />
    </view>
    <view class="input-group">
      <label>密码</label>
      <input placeholder="请输入密码" password bindinput="onInput" data-field="password" />
    </view>

    <button class="btn-primary" loading="{{loading}}" bindtap="handleLogin" style="margin-top:32rpx">
      登录
    </button>

    <view style="text-align:center;margin-top:24rpx;color:#999">
      还没有账号？<navigator url="/pages/register/register" style="color:#1890ff">立即注册</navigator>
    </view>
  </view>
</view>
