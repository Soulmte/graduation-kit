<view class="container">
  <view class="card">
    <view class="page-title">注册账号</view>

    <view class="input-group">
      <label>用户名</label>
      <input placeholder="字母开头，3-50个字符" bindinput="onInput" data-field="username" />
    </view>
    <view class="input-group">
      <label>密码</label>
      <input placeholder="至少6位" password bindinput="onInput" data-field="password" />
    </view>
    <view class="input-group">
      <label>确认密码</label>
      <input placeholder="再次输入密码" password bindinput="onInput" data-field="confirm" />
    </view>
    <view class="input-group">
      <label>昵称（选填）</label>
      <input placeholder="请输入昵称" bindinput="onInput" data-field="nickname" />
    </view>
    <view class="input-group">
      <label>手机号（选填）</label>
      <input placeholder="请输入手机号" bindinput="onInput" data-field="phone" />
    </view>
    <view class="input-group">
      <label>邮箱（选填）</label>
      <input placeholder="请输入邮箱" bindinput="onInput" data-field="email" />
    </view>

    <button class="btn-primary" loading="{{loading}}" bindtap="handleRegister" style="margin-top:32rpx">
      注册
    </button>

    <view style="text-align:center;margin-top:24rpx;color:#999">
      已有账号？<navigator url="/pages/login/login" style="color:#1890ff">立即登录</navigator>
    </view>
  </view>
</view>
