<view class="page">
  <view class="block">
    <t-cell-group theme="default">
      <t-input label="用户名 *" placeholder="字母开头，3-50 个字符" value="{{username}}" data-field="username" bind:change="onInput" borderless />
      <t-input label="密码 *" type="password" placeholder="至少 6 位" value="{{password}}" data-field="password" bind:change="onInput" borderless />
      <t-input label="确认密码 *" type="password" placeholder="再次输入密码" value="{{confirm}}" data-field="confirm" bind:change="onInput" borderless />
    </t-cell-group>
  </view>

  <view class="block">
    <t-cell-group theme="default" title="选填信息">
      <t-input label="昵称" placeholder="请输入昵称" value="{{nickname}}" data-field="nickname" bind:change="onInput" borderless />
      <t-input label="手机号" type="number" placeholder="请输入手机号" value="{{phone}}" maxlength="11" data-field="phone" bind:change="onInput" borderless />
      <t-input label="邮箱" placeholder="请输入邮箱" value="{{email}}" data-field="email" bind:change="onInput" borderless />
    </t-cell-group>
  </view>

  <view class="actions">
    <view
      class="app-btn app-btn--primary {{loading ? 'app-btn--disabled' : ''}}"
      hover-class="app-btn--hover"
      bindtap="handleRegister"
    >
      {{loading ? '提交中…' : '注册'}}
    </view>
  </view>

  <view class="foot-link">
    <text>已有账号？</text>
    <text class="link" bindtap="goLogin">返回登录</text>
  </view>
</view>
