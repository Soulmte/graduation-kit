page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.text-primary {
  color: #1890ff;
  font-weight: 600;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-group label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input-group input,
.input-group picker {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.notice-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.notice-item:last-child { border-bottom: 0; }

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.notice-desc {
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}
.notice-time {
  font-size: 24rpx;
  color: #ccc;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}
.detail-time {
  font-size: 26rpx;
  color: #ccc;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}
