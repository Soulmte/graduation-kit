{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"]
		},
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"**/*.js",
		"**/*.vue"
	],
	"exclude": [
		"node_modules",
		"unpackage"
	]
}
