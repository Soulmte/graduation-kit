{
  "expo": {
    "name": "脚手架移动端",
    "slug": "scaffold-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "scaffold",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scaffold.mobile"
    },
    "android": {
      "package": "com.scaffold.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1890ff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择头像和上传图片"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
